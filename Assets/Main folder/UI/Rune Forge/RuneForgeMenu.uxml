<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Main%20folder/UI/Rune Forge/RuneForgeMenu.uss" />

    <ui:VisualElement name="ForgeRoot" class="forge-overlay" style="display: none;">

        <!-- EKRAN 1: WYBÓR WIEŻY -->
        <ui:VisualElement name="TowerSelectScreen" class="tower-select-panel">
            <ui:Label text="WYBIERZ WIEŻĘ DO ZINFUZOWANIA" style="font-size: 20px; color: #ffaa00; -unity-font-style: bold; -unity-text-align: middle-center;" />
            <ui:Label text="Ten wybór jest stały dla tej Kuźni." style="color: #aaa; -unity-text-align: middle-center; margin-bottom: 10px;" />
            <ui:ScrollView name="TowerGrid" style="min-height: 250px; margin-top: 15px; margin-bottom: 15px;" />
            <ui:Button name="Btn_CloseTowerSelect" text="ZAMKNIJ" class="forge-action-btn" style="margin-top: 20px;" />
        </ui:VisualElement>

        <!-- EKRAN 2: ZARZĄDZANIE RUNAMI -->
        <ui:VisualElement name="MainForgeScreen" class="forge-main-panel" style="display: none;">
            
            <!-- Lewy panel (Akcje) -->
            <ui:VisualElement class="forge-left-panel">
                <ui:VisualElement>
                    <ui:Label name="Lbl_ForgeTarget" text="Zinfuzowano: Arbalest" style="font-size: 16px; color: #ffaa00; -unity-font-style: bold; margin-bottom: 20px;" />
                    <ui:Button name="Btn_Fusion" text="FUZJA (2 takie same)" class="forge-action-btn" />
                    <ui:Button name="Btn_Transmute" text="TRANSMUTACJA (3 różne)" class="forge-action-btn" />
                </ui:VisualElement>
                
                <ui:VisualElement class="rune-info-box">
                    <ui:Label name="Lbl_InfoTitle" text="Wybierz runę..." style="color: #ffaa00; font-size: 14px; -unity-font-style: bold; margin-bottom: 10px;" />
                    <ui:Label name="Lbl_InfoStats" text="" style="color: white; font-size: 12px; white-space: normal;" />
                </ui:VisualElement>

                <ui:Button name="Btn_CloseForge" text="WYJDŹ" class="forge-action-btn" style="background-color: #5a1a1a;" />
            </ui:VisualElement>

            <!-- Prawy panel (Ekwipunek i Sloty) -->
            <ui:VisualElement class="forge-right-panel">
                <ui:Label text="TWOJE RUNY" style="color: #aaa; font-size: 14px; margin-bottom: 5px;" />
                <ui:ScrollView name="InventoryGrid" class="inventory-grid" style="flex-grow: 1; border-color: #333; border-width: 1px; padding: 5px;" />

                <ui:Label text="SLOTY KUŹNI (Kliknij aby wyjąć / Wymaga Dnia)" style="color: #aaa; font-size: 14px; margin-top: 15px;" />
                <ui:VisualElement name="ForgeSlots" class="forge-slots-container" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- POPUP POTWIERDZENIA (Wspólny) -->
        <ui:VisualElement name="ConfirmPopup" class="popup-box" style="display: none;">
            <ui:Label name="Lbl_PopupText" text="Czy na pewno?" style="color: white; font-size: 16px; white-space: normal; -unity-text-align: middle-center;" />
            <ui:VisualElement class="popup-row">
                <ui:Button name="Btn_PopupYes" text="TAK" class="popup-btn" style="background-color: #1a5a1a;" />
                <ui:Button name="Btn_PopupNo" text="ANULUJ" class="popup-btn" style="background-color: #5a1a1a;" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>