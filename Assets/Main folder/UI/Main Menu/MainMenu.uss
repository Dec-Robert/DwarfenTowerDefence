/* G£ÓWNE T£O */
.root-container {
    flex-grow: 1;
    align-items: center; /* Wyœrodkowanie w poziomie */
    justify-content: center; /* Wyœrodkowanie w pionie */
    background-color: rgb(20, 20, 25); /* Ciemne t³o, mo¿esz tu daæ obrazek */
}

/* TYTU£ GRY */
.game-title {
    font-size: 60px;
    -unity-font-style: bold;
    color: #FFD700; /* Z³oty */
    margin-bottom: 50px;
    text-shadow: 2px 2px 0px rgba(0,0,0,0.5);
    -unity-text-align: middle-center;
}

/* KONTENER PRZYCISKÓW */
.button-container {
    width: 300px;
    align-items: stretch;
}

/* STYL PRZYCISKU */
.menu-btn {
    height: 60px;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    background-color: #3E3E3E;
    border-width: 0;
    border-radius: 8px;
    margin-bottom: 15px;
    transition: 0.1s;
}

/* HOVER (Najazd myszk¹) */
.menu-btn:hover {
    background-color: #5A5A5A;
    scale: 1.05;
    color: #FFD700;
}

/* ACTIVE (Klikniêcie) */
.menu-btn:active {
    background-color: #222;
    scale: 0.95;
}

    /* --- KONTENERY --- */
.menu-container {
    width: 300px;
    align-items: stretch;
}

.progression-container {
    width: 800px;
    height: 600px;
    background-color: rgba(30, 30, 35, 0.95);
    border-radius: 10px;
    padding: 20px;
    align-items: center;
}

/* --- PRZYCISKI SPECJALNE --- */
.start-btn { background-color: #2E7D32; }
.start-btn:hover { background-color: #4CAF50; }

.back-btn { background-color: #C62828; }
.back-btn:hover { background-color: #E53935; }

/* --- PROGRESJA HEADER --- */
.progression-header {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: #555;
    padding-bottom: 10px;
}

.currency-text { color: #FFD700; font-size: 20px; -unity-font-style: bold; }
.progress-text { color: #AAA; font-size: 18px; }

/* --- ZAK£ADKI --- */
.tabs-container {
    flex-direction: row;
    width: 100%;
    margin-bottom: 15px;
}

.tab-btn {
    flex-grow: 1;
    height: 40px;
    background-color: #333;
    color: #888;
    border-width: 0;
    font-size: 16px;
    margin: 2px;
}

.tab-active {
    background-color: #4CAF50; /* Aktywna zak³adka */
    color: white;
}

.tab-locked {
    background-color: #222;
    color: #555;
}

/* --- LISTA ULEPSZEÑ --- */
.meta-scroll-view {
    width: 100%;
    flex-grow: 1;
    background-color: rgba(0,0,0,0.3);
}

/* KARTA ULEPSZENIA (Generowana w C#) */
.upgrade-card {
    flex-direction: row;
    background-color: #444;
    margin-bottom: 10px;
    padding: 10px;
    border-radius: 5px;
    align-items: center;
    justify-content: space-between;
}

.upgrade-card-unlocked {
    background-color: #2E5D32; /* Ciemnozielony dla kupionych */
    border-color: #4CAF50;
    border-width: 1px;
}

.card-info { flex-grow: 1; margin-left: 10px; }
.card-title { color: white; font-size: 16px; -unity-font-style: bold; }
.card-desc { color: #CCC; font-size: 12px; white-space: normal; }

.card-buy-btn {
    width: 100px;
    background-color: #FFD700;
    color: black;
    -unity-font-style: bold;
}
.card-buy-btn:hover { background-color: #FFEA00; }