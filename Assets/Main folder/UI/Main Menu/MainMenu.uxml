<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Main%20folder/UI/Main%20Menu/MainMenu.uss?fileID=7433441132597879392&amp;guid=2651afd0e3d3e5940905648d6bb0beea&amp;type=3#MainMenu" />
    <ui:VisualElement name="Root" class="root-container">
        <ui:Label text="MOJA GRA STRATEGICZNA" class="game-title" />
        <ui:VisualElement name="Menu_Main" class="menu-container">
            <ui:Button name="Btn_OpenPlay" text="ROZPOCZNIJ GRĘ" class="menu-btn" />
            <ui:Button name="Btn_Settings" text="USTAWIENIA" class="menu-btn" />
            <ui:Button name="Btn_Feedback" text="FEEDBACK" class="menu-btn" />
            <ui:Button name="Btn_Quit" text="WYJDŹ" class="menu-btn" />
        </ui:VisualElement>
        <ui:VisualElement name="Menu_Play" class="menu-container" style="display: none;">
            <ui:Label text="Wybierz Tryb" style="color: rgb(170, 170, 170); font-size: 18px; margin-bottom: 20px;" />
            <ui:Button name="Btn_StartGame" text="GRAJ" class="menu-btn start-btn" />
            <ui:Button name="Btn_OpenProgression" text="PROGRESJA" class="menu-btn" />
            <ui:Button name="Btn_BackToMain" text="WRÓĆ" class="menu-btn back-btn" />
        </ui:VisualElement>
        <ui:VisualElement name="Menu_Progression" class="progression-container" style="display: none;">
            <ui:VisualElement class="progression-header">
                <ui:Label name="Lbl_Currency" text="Artefakty: 0" class="currency-text" />
                <ui:Label name="Lbl_Progress" text="Odblokowano: 0/5" class="progress-text" />
            </ui:VisualElement>
            <ui:VisualElement class="tabs-container">
                <ui:Button name="Tab_Meta" text="META ULEPSZENIA" class="tab-btn tab-active" />
                <ui:Button name="Tab_Towers" text="WIEŻE (Wkrótce)" class="tab-btn tab-locked" />
            </ui:VisualElement>
            <ui:ScrollView name="MetaList" class="meta-scroll-view" />
            <ui:Button name="Btn_BackToPlay" text="WRÓĆ" class="menu-btn back-btn" style="width: 200px; margin-top: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
