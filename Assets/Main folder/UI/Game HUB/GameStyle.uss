/* ============================================================
   GAMESTYLE – "MROCZNA TWIERDZA"
   Panel Settings: Scale With Screen Size, 1920x1080, Match 0.5
   ============================================================ */

.root-container {
    flex-grow: 1;
    justify-content: space-between;
    width: 100%;
    height: 100%;
}

/* ============================================================
   TOP BAR
   ============================================================ */

.top-bar {
    flex-direction: row;
    background-color: rgba(12, 10, 8, 0.97);
    border-bottom-width: 2px;
    border-bottom-color: #8B6914;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    padding: 5px 10px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: auto;
    min-width: 70px;
    height: 32px;
    flex-shrink: 1;
    flex-grow: 0;
    background-color: rgba(20, 16, 5, 0.9);
    border-radius: 2px;
    border-width: 1px;
    border-color: #2A2010;
    border-bottom-width: 2px;
    border-bottom-color: #5A4000;
    padding-left: 7px;
    padding-right: 9px;
    margin: 2px;
}

.resource-item:hover {
    background-color: rgba(35, 28, 8, 0.95);
    border-bottom-color: #FFD700;
}

.resource-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    background-color: rgba(0,0,0,0);
    margin-right: 5px;
    border-radius: 2px;
}

.resource-text {
    font-size: 12px;
    color: #DDC880;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.time-text {
    font-size: 13px;
    color: #44FF88;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 2px 8px;
    background-color: rgba(5, 20, 5, 0.6);
    border-width: 1px;
    border-color: #1A4A1A;
    border-radius: 2px;
    padding: 3px 9px;
    height: 32px;
    -unity-text-align: middle-center;
}

/* ============================================================
   BEACON DISPLAY
   ============================================================ */

.beacon-display-wrapper {
    align-items: center;
    padding: 3px 0px 2px 0px;
    background-color: rgba(8, 6, 3, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: #2A1800;
    width: 100%;
}

.beacon-bar-bg {
    flex-direction: row;
    background-color: rgba(10, 7, 3, 0.95);
    padding: 3px 8px;
    border-radius: 2px;
    border-width: 1px;
    border-color: #3A2800;
    border-bottom-width: 2px;
    border-bottom-color: #5A3A00;
    align-items: center;
}

.beacon-segment {
    width: 16px;
    height: 10px;
    margin: 1px 2px;
    border-radius: 1px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: #1A1000;
}

.beacon-fuel-label {
    color: #5A4020;
    font-size: 9px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    margin-top: 1px;
}

/* ============================================================
   DOLNY PASEK – JEDEN SPÓJNY KONTENER
   [⏸ 1x 2x 3x 5x | BUDUJ | PROD OBRONA DOMY | karty → ]
   ============================================================ */

.bottom-container {
    flex-direction: row;
    align-items: center;
    width: 100%;
    background-color: rgba(12, 10, 8, 0.97);
    border-top-width: 2px;
    border-top-color: #8B6914;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    padding: 5px 8px;
    min-height: 70px;
}

/* Cienki separator pionowy między sekcjami */
.bottom-divider {
    width: 1px;
    align-self: stretch;
    background-color: #2A2010;
    margin: 4px 6px;
    flex-shrink: 0;
}

/* --- Kontrola prędkości (pierwsza od lewej) --- */
.time-controls-panel {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 0px;
    border-width: 0;
    background-color: transparent;
}

.time-btn {
    width: 30px;
    height: 30px;
    margin: 0px 2px 0px 0px;
    background-color: rgba(22, 18, 6, 0.95);
    border-radius: 1px;
    border-width: 1px;
    border-color: #2A2008;
    color: #776600;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0px;
    flex-shrink: 0;
}

.time-btn:hover {
    background-color: rgba(50, 40, 10, 0.95);
    border-color: #FFD700;
    color: #FFD700;
}

.time-btn-active {
    background-color: rgba(50, 40, 8, 0.95);
    border-color: #AA8800;
    border-bottom-width: 2px;
    border-bottom-color: #FFD700;
    color: #FFD700;
}

/* --- Przycisk BUDUJ / X --- */
.main-build-btn {
    width: 52px;
    height: 54px;
    background-color: rgba(20, 40, 20, 0.95);
    border-radius: 2px;
    border-width: 1px;
    border-color: #2A6A2A;
    border-top-width: 2px;
    border-top-color: #44CC44;
    font-size: 10px;
    -unity-font-style: bold;
    color: #88FF88;
    letter-spacing: 1px;
    margin: 0px 6px;
    flex-shrink: 0;
    padding: 0px;
    -unity-text-align: middle-center;
}

.main-build-btn:hover {
    background-color: rgba(35, 65, 35, 0.95);
    border-top-color: #88FF88;
    color: #AAFFAA;
}

.main-build-btn:active { scale: 0.97; }

.main-build-btn-open {
    background-color: rgba(40, 10, 10, 0.95);
    border-top-color: #FF6666;
    border-color: #6A2A2A;
    color: #FF8888;
}

/* --- Panel kategorii --- */
.category-panel {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 4px;
    background-color: transparent;
    border-width: 0;
    padding: 0px;
}

.category-btn {
    width: 50px;
    height: 54px;
    margin: 0px 2px;
    background-color: rgba(18, 14, 4, 0.9);
    color: #776600;
    font-size: 8px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-radius: 1px;
    border-width: 1px;
    border-color: #2A2010;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0px;
}

.category-btn:hover {
    background-color: rgba(40, 32, 8, 0.95);
    border-top-width: 2px;
    border-top-color: #FFD700;
    color: #FFD700;
}

.category-btn-active {
    background-color: rgba(45, 36, 6, 0.95);
    border-top-width: 2px;
    border-top-color: #FFD700;
    border-color: #5A4500;
    color: #FFD700;
}

/* --- Lista budynków (wypełnia resztę szerokości) --- */
.buildings-list-panel {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    background-color: rgba(8, 7, 3, 0.45);
    border-radius: 1px;
    border-width: 1px;
    border-color: #1A1408;
    padding: 3px 4px;
    justify-content: center;
}

.buildings-scroll-view {
    height: 100%;
    width: 100%;
}

.buildings-container {
    flex-direction: row;
    align-items: center;
    height: 100%;
}

.generated-build-btn {
    width: 58px;
    height: 58px;
    margin: 2px 3px;
    background-color: rgba(20, 16, 5, 0.9);
    border-radius: 2px;
    border-width: 1px;
    border-color: #2A2010;
    border-bottom-width: 2px;
    border-bottom-color: #5A4500;
    justify-content: flex-end;
    overflow: hidden;
    flex-shrink: 0;
}

.generated-build-btn:hover {
    border-top-width: 2px;
    border-top-color: #FFD700;
    border-color: #8B6914;
    scale: 1.06;
}

#unity-vertical-scroller { display: none; width: 0; }

#unity-horizontal-scroller {
    height: 4px;
    margin-top: 2px;
}

#unity-horizontal-scroller #unity-dragger {
    background-color: #3A2800;
    border-radius: 2px;
    height: 4px;
}

/* ============================================================
   TOOLTIPY
   ============================================================ */

.tooltip-box {
    background-color: rgba(10, 8, 3, 0.98);
    border-width: 1px;
    border-color: #3A2800;
    border-top-width: 2px;
    border-top-color: #FFD700;
    border-radius: 2px;
    padding: 10px;
    width: 210px;
}

.tooltip-header {
    color: #FFD700;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #2A2010;
    padding-bottom: 3px;
}

.tooltip-text {
    color: #998860;
    font-size: 10px;
    white-space: normal;
    margin-bottom: 4px;
}

.tooltip-cost {
    color: #FF8888;
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 3px;
    border-top-width: 1px;
    border-top-color: #2A2010;
    padding-top: 3px;
}

/* ============================================================
   MENU EKSPANSJI
   ============================================================ */

.expansion-panel {
    width: 260px;
    background-color: rgba(10, 8, 3, 0.98);
    border-color: #2A3A4A;
    border-top-color: #88AACC;
    border-width: 1px;
    border-top-width: 3px;
    border-radius: 2px;
    padding: 14px;
    align-items: stretch;
}

.expansion-header {
    color: #88CCFF;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: #1A2A3A;
    margin-bottom: 8px;
    padding-bottom: 5px;
    -unity-text-align: middle-center;
}

.expansion-text {
    color: #7788AA;
    font-size: 10px;
    white-space: normal;
    margin-bottom: 5px;
}

.expansion-btn-buy {
    background-color: rgba(20, 40, 20, 0.95);
    color: #88FF88;
    border-width: 1px;
    border-color: #2A6A2A;
    border-radius: 1px;
    flex-grow: 1;
    margin-right: 4px;
    height: 30px;
    font-size: 10px;
    -unity-font-style: bold;
}

.expansion-btn-buy:hover    { background-color: rgba(35, 65, 35, 0.95); }
.expansion-btn-buy:disabled { background-color: rgba(15,15,15,0.8); color: #333; border-color: #1A1A1A; }

.expansion-btn-close {
    background-color: rgba(40, 10, 10, 0.95);
    color: #FF8888;
    border-width: 1px;
    border-color: #6A2A2A;
    border-radius: 1px;
    flex-grow: 1;
    margin-left: 4px;
    height: 30px;
    font-size: 10px;
}

.expansion-btn-close:hover { background-color: rgba(65, 20, 20, 0.95); }

/* ============================================================
   TUTORIAL POPUP
   ============================================================ */

.tutorial-popup {
    background-color: rgba(10, 8, 3, 0.98);
    border-width: 1px;
    border-color: #5A4500;
    border-top-width: 3px;
    border-top-color: #FFD700;
    border-radius: 2px;
    padding: 14px;
    padding-top: 22px;
}

.tutorial-text {
    color: #998860;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.tutorial-close-btn {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 18px;
    height: 18px;
    background-color: #660000;
    color: #FFB0B0;
    font-size: 10px;
    border-radius: 1px;
    border-width: 1px;
    border-color: #990000;
    padding: 0px;
}

.tutorial-close-btn:hover { background-color: #CC0000; }

/* ============================================================
   RESOURCE TOOLTIP
   ============================================================ */

.resource-tooltip {
    position: absolute;
    background-color: rgba(10, 8, 3, 0.98);
    border-radius: 2px;
    border-width: 1px;
    border-color: #3A2800;
    border-top-width: 2px;
    border-top-color: #FFD700;
    padding: 8px;
    width: 170px;
}

/* ============================================================
   IKONY ZASOBÓW
   ============================================================ */

.icon-gold  { background-image: url('project://database/Assets/Main folder/Icons/Resources/Gold.tif');  }
.icon-wood  { background-image: url('project://database/Assets/Main folder/Icons/Resources/Wood.tif');  }
.icon-stone { background-image: url('project://database/Assets/Main folder/Icons/Resources/Stone.tif'); }
.icon-iron  { background-image: url('project://database/Assets/Main folder/Icons/Resources/Iron.tif');  }
.icon-coal  { background-image: url('project://database/Assets/Main folder/Icons/Resources/Coal.tif');  }
.icon-food  { background-image: url('project://database/Assets/Main folder/Icons/Resources/Food.tif');  }
