<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Main%20folder/UI/BuildingInspector.uss?fileID=7433441132597879392&amp;guid=e85767294a07a3448b3149e46c962958&amp;type=3#BuildingInspector" />
    <ui:VisualElement name="TotalContainer" class="total-container" style="display: none;">
        <ui:VisualElement name="UpgradeDetailsPanel" class="details-panel" style="display: none;">
            <ui:Label name="Det_Title" text="Nazwa Ulepszenia" style="color: rgb(255, 215, 0); -unity-font-style: bold; margin-bottom: 5px; font-size: 14px;" />
            <ui:Label name="Det_Desc" text="Opis co to robi..." style="color: rgb(204, 204, 204); font-size: 11px; white-space: normal; margin-bottom: 10px;" />
            <ui:Label name="Det_Effects" text="Efekty..." style="color: rgb(255, 255, 255); font-size: 11px; margin-bottom: 5px;" />
            <ui:Label name="Det_Cost" text="Koszt..." style="color: rgb(255, 170, 170); font-size: 11px; -unity-font-style: bold; margin-bottom: 10px;" />
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-top: auto;">
                <ui:Button name="Btn_ConfirmBuy" text="KUP" style="background-color: rgb(76, 175, 80); color: white; flex-grow: 1; margin-right: 5px;" />
                <ui:Button name="Btn_CancelBuy" text="ANULUJ" style="background-color: rgb(244, 67, 54); color: white; flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="InspectorRoot" class="inspector-window">
            <ui:Button name="Btn_Close" text="X" class="close-btn" />
            <ui:Label name="Lbl_Name" text="Budynek" class="inspector-header" />
            <ui:VisualElement name="BeaconControlSection" style="display: none; background-color: rgba(60, 30, 0, 0.8); padding: 10px; border-radius: 5px; margin-bottom: 15px; border-width: 1px; border-color: rgb(255, 136, 0);">
                <ui:Label text="ZARZĄDZANIE PALIWEM" style="color: rgb(255, 187, 0); -unity-font-style: bold; margin-bottom: 5px; -unity-text-align: middle-center; font-size: 12px;" />
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center;">
                    <ui:Label text="Dzienny Wsad:" style="color: rgb(221, 221, 221); font-size: 11px; margin-right: 5px;" />
                    <ui:SliderInt name="Slider_CoalInput" low-value="0" high-value="20" style="flex-grow: 1;" />
                    <ui:Label name="Lbl_CoalInputVal" text="0" style="color: white; font-size: 12px; -unity-font-style: bold; width: 30px; -unity-text-align: middle-right;" />
                </ui:VisualElement>
                <ui:Label text="Węgiel jest pobierany automatycznie o świcie." style="color: rgb(170, 170, 170); font-size: 9px; margin-top: 5px; white-space: normal; -unity-text-align: middle-center;" />
            </ui:VisualElement>

            <ui:VisualElement name="HousingSection" style="display: none; background-color: rgba(0, 40, 0, 0.3); padding: 10px; border-radius: 5px; margin-bottom: 10px;">
                <ui:Label text="STATYSTYKI MIESZKALNE" style="color: #44FF44; -unity-font-style: bold; margin-bottom: 5px; -unity-text-align: middle-center;" />

                <!-- Pasek Progresu Narodzin -->
                <ui:VisualElement style="margin-bottom: 10px;">
                    <ui:Label text="Postęp narodzin:" style="color: #DDD; font-size: 10px;" />
                    <ui:VisualElement name="BirthBarContainer" style="height: 12px; background-color: #222; border-radius: 4px; overflow: hidden; border-width: 1px; border-color: #444;">
                        <ui:VisualElement name="BirthBarFill" style="width: 0%; height: 100%; background-color: #4CAF50;" />
                    </ui:VisualElement>
                    <ui:Label name="Lbl_BirthDays" text="Pozostało: 2 dni" style="color: #AAA; font-size: 9px; -unity-text-align: middle-right;" />
                </ui:VisualElement>

                <!-- Kapsułki Zakwaterowania -->
                <ui:Label text="Mieszkańcy:" style="color: #DDD; font-size: 10px; margin-bottom: 2px;" />
                <ui:VisualElement name="ResidentCapsules" style="flex-direction: row; justify-content: center; margin-bottom: 10px;" />

                <!-- Szczegółowa Konsumpcja -->
                <ui:VisualElement style="background-color: rgba(0,0,0,0.2); padding: 5px; border-radius: 3px;">
                    <ui:Label name="Lbl_HouseBase" text="Koszt bazowy: 1 Food" style="color: #CCC; font-size: 10px;" />
                    <ui:Label name="Lbl_HouseMaintenance" text="Utrzymanie: 0.5 Food" style="color: #CCC; font-size: 10px;" />
                    <ui:Label name="Lbl_HouseTotal" text="SUMA (06:00): 1.5 Food" style="color: #FFF; -unity-font-style: bold; font-size: 11px; margin-top: 3px; border-top-width: 1px; border-top-color: #444;" />
                </ui:VisualElement>

                <!-- Modyfikatory i Status -->
                <ui:VisualElement style="margin-top: 5px; flex-direction: row; justify-content: space-between;">
                    <ui:Label name="Lbl_GrowthMod" text="Mod: +10%" style="color: #FFFF44; font-size: 10px;" />
                    <ui:Label name="Lbl_HouseStatus" text="Status: Rosnący" style="color: #44FF44; font-size: 10px; -unity-font-style: italic;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="StatsContainer" style="display: none;">
                <ui:Label name="Lbl_Production" text="Produkcja..." style="color: rgb(136, 255, 136); font-size: 11px; white-space: normal;" />
                <ui:Label name="Lbl_Upkeep" text="Utrzymanie..." style="color: rgb(255, 136, 136); font-size: 11px; white-space: normal;" />
            </ui:VisualElement>
            <ui:VisualElement name="BudgetSection" style="margin-bottom: 10px; background-color: rgba(0, 0, 0, 0.2); padding: 5px; border-radius: 4px;">
                <ui:Label text="ZAPAS OPERACYJNY" style="color: #DDD; font-size: 10px; -unity-font-style: bold; margin-bottom: 3px;" />
                <ui:VisualElement name="BudgetContainer" />
            </ui:VisualElement>
            <ui:VisualElement name="CombatStatsContainer" style="display: none; margin-bottom: 10px; background-color: rgba(0, 0, 0, 0.3); padding: 5px; border-radius: 4px;">
                <ui:Label name="Lbl_Damage" text="Obrażenia: 10" style="color: rgb(255, 68, 68); font-size: 12px; -unity-font-style: bold;" />
                <ui:Label name="Lbl_Range" text="Zasięg: 5" style="color: rgb(68, 255, 255); font-size: 12px;" />
                <ui:Label name="Lbl_FireRate" text="Szybkość: 1.0/s" style="color: rgb(255, 255, 68); font-size: 12px;" />
            </ui:VisualElement>
            <ui:VisualElement name="WorkerSection" class="worker-section">
                <ui:Label text="PRACOWNICY" style="color: rgb(221, 221, 221); -unity-font-style: bold; margin-bottom: 5px;" />
                <ui:VisualElement name="ShiftsContainer" />
                <ui:VisualElement class="worker-controls">
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label text="L" style="color: white; font-size: 10px;" />
                        <ui:VisualElement style="flex-direction: row;">
                            <ui:Button name="Btn_AddHuman" text="+" class="worker-btn btn-add" />
                            <ui:Button name="Btn_RemHuman" text="-" class="worker-btn btn-remove" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label text="E" style="color: white; font-size: 10px;" />
                        <ui:VisualElement style="flex-direction: row;">
                            <ui:Button name="Btn_AddElf" text="+" class="worker-btn btn-add" />
                            <ui:Button name="Btn_RemElf" text="-" class="worker-btn btn-remove" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="align-items: center;">
                        <ui:Label text="K" style="color: white; font-size: 10px;" />
                        <ui:VisualElement style="flex-direction: row;">
                            <ui:Button name="Btn_AddDwarf" text="+" class="worker-btn btn-add" />
                            <ui:Button name="Btn_RemDwarf" text="-" class="worker-btn btn-remove" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="Lbl_WorkerCounts" text="H:0 | E:0 | D:0" style="color: rgb(170, 170, 170); font-size: 10px; margin-top: 5px; -unity-text-align: middle-center;" />
            </ui:VisualElement>
            <ui:VisualElement name="UpgradeSection" class="upgrade-section">
                <ui:Label text="DOSTĘPNE ULEPSZENIA" style="color: rgb(255, 215, 0); font-size: 12px; margin-bottom: 5px;" />
                <ui:VisualElement name="UpgradesList" />
            </ui:VisualElement>
            <ui:Button name="Btn_Destroy" text="ZBURZ BUDYNEK" style="background-color: rgb(136, 0, 0); color: white; margin-top: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
