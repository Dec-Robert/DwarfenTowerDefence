<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Main%20folder/UI/BuildingInspector.uss?fileID=7433441132597879392&amp;guid=e85767294a07a3448b3149e46c962958&amp;type=3#BuildingInspector" />
    <Style src="project://database/Assets/Main%20folder/UI/GameStyle.uss?fileID=7433441132597879392&amp;guid=fbb7a55e69984804cb377c49a28dc3f7&amp;type=3#GameStyle" />
    <ui:VisualElement name="Root" picking-mode="Ignore" class="root-container">
        <ui:VisualElement name="TopBar" class="top-bar">

            <ui:VisualElement name="HP_Group" class="resource-item">
                <ui:VisualElement class="resource-icon" style="background-color: rgb(255, 0, 0);" />
                <ui:Label text="20" name="Label_HP" class="resource-text" />
            </ui:VisualElement>

            <ui:VisualElement name="Gold_Group" class="resource-item">
                <ui:VisualElement class="resource-icon icon-gold"/>
                <ui:Label text="100" name="Label_Gold" class="resource-text" />
            </ui:VisualElement>

            <ui:VisualElement name="Wood_Group" class="resource-item">
                <ui:VisualElement class="resource-icon icon-wood"/>
                <ui:Label text="50" name="Label_Wood" class="resource-text" />
            </ui:VisualElement>

            <ui:VisualElement name="Stone_Group" class="resource-item">
                <ui:VisualElement class="resource-icon icon-stone"/>
                <ui:Label text="0" name="Label_Stone" class="resource-text" />
            </ui:VisualElement>

            <ui:VisualElement name="Food_Group" class="resource-item">
                <ui:VisualElement class="resource-icon icon-food"/>
                <ui:Label text="20" name="Label_Food" class="resource-text" />
            </ui:VisualElement>

            <ui:VisualElement name="Coal_Group" class="resource-item">
                <ui:VisualElement class="resource-icon icon-coal" />
                <ui:Label text="0" name="Label_Coal" class="resource-text" />
            </ui:VisualElement>

            <ui:VisualElement name="Iron_Group" class="resource-item">
                <ui:VisualElement class="resource-icon icon-iron" />
                <ui:Label text="0" name="Label_Iron" class="resource-text" />
            </ui:VisualElement>

            <ui:Label text="Dzień 1 | 06:00" name="Label_Time" class="resource-text time-text" style="color: rgb(68, 255, 68); -unity-font-style: bold; font-size: 20px; margin-left: 50px;" />
            <ui:VisualElement name="Pop_Group" class="resource-item" style="height: 36px; width: 202px;">
                <ui:VisualElement class="resource-icon" style="background-color: rgb(0, 191, 255);" />
                <ui:Label text="H:0 | E:0 | D:0" name="Label_Pop" class="resource-text" style="min-width: 120px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="BeaconDisplay" style="position: absolute; top: 68px; left: 614px; translate: -50% 0; flex-direction: column; align-items: center; height: 45px;">
            <ui:VisualElement name="SegmentsBackground" class="beacon-bar-bg">
                <ui:VisualElement name="Segment_0" class="beacon-segment" />
                <ui:VisualElement name="Segment_1" class="beacon-segment" />
                <ui:VisualElement name="Segment_2" class="beacon-segment" />
                <ui:VisualElement name="Segment_3" class="beacon-segment" />
                <ui:VisualElement name="Segment_4" class="beacon-segment" />
                <ui:VisualElement name="Segment_5" class="beacon-segment" />
                <ui:VisualElement name="Segment_6" class="beacon-segment" />
                <ui:VisualElement name="Segment_7" class="beacon-segment" />
                <ui:VisualElement name="Segment_8" class="beacon-segment" />
            </ui:VisualElement>
            <ui:VisualElement name="SegmentsBackground" class="beacon-bar-bg">
                <ui:Label name="Lbl_FuelInfo" text="Paliwo: 60/100" style="color: rgb(170, 170, 170); font-size: 10px; margin-top: 2px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="BottomContainer" class="bottom-container" style="justify-content: flex-start; align-items: flex-end;">
            
            <!-- 1. GŁÓWNY PRZYCISK BUDOWANIA (LEWY DOLNY RÓG) -->
            <ui:Button name="Btn_MainBuild" text="BUDUJ" class="main-build-btn" />

            <!-- 2. PANEL KATEGORII (Obok przycisku Buduj) -->
            <ui:VisualElement name="CategoryPanel" class="category-panel" style="display: none;">
                <ui:Button name="Btn_Cat_Production" text="PROD" class="category-btn" />
                <ui:Button name="Btn_Cat_Defense" text="OBRONA" class="category-btn" />
                <ui:Button name="Btn_Cat_Housing" text="DOMY" class="category-btn" />
            </ui:VisualElement>

            <!-- 3. PANEL WYBORU BUDYNKÓW (Środek, Scroll View) -->
            <ui:VisualElement name="BuildingsListPanel" class="buildings-list-panel" style="display: none;">
                <!-- mode="Horizontal" oraz wyłączenie vertical scroller visibility -->
                <ui:ScrollView 
                    mode="Horizontal" 
                    vertical-scroller-visibility="Hidden" 
                    horizontal-scroller-visibility="Auto" 
                    class="buildings-scroll-view"
                >
                    <ui:VisualElement name="BuildingsContainer" class="buildings-container" />
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- 4. KONTROLA CZASU (Prawa Strona - absolute, żeby nie psuła layoutu) -->
            <ui:VisualElement name="TimeControls" class="time-controls-panel" style="position: absolute; right: 10px; bottom: 10px;">
                <ui:Button text="||" name="Btn_Pause" class="time-btn" />
                <ui:Button text="1x" name="Btn_1x" class="time-btn" />
                <ui:Button text="2x" name="Btn_2x" class="time-btn" />
                <ui:Button text="3x" name="Btn_3x" class="time-btn" />
                <ui:Button text="5x" name="Btn_5x" class="time-btn" />
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="ExpansionMenu" class="expansion-panel" style="display: none;">
            <ui:Label name="Exp_Title" text="Nieznane Ziemie" class="expansion-header" />
            <ui:Label name="Exp_Description" text="Opis statusu..." class="expansion-text" />
            <ui:VisualElement name="Exp_CostContainer" style="flex-direction: row; margin-top: 10px; margin-bottom: 10px;">
                <ui:Label text="Koszt: " style="color: rgb(204, 204, 204); font-size: 14px;" />
                <ui:Label name="Exp_CostVal" text="100 G" style="color: rgb(255, 215, 0); -unity-font-style: bold; font-size: 14px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Button name="Btn_Exp_Buy" text="ODKRYJ" class="expansion-btn-buy" />
                <ui:Button name="Btn_Exp_Close" text="ANULUJ" class="expansion-btn-close" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="TotalContainer" class="total-container" style="display: none;" />
        <ui:VisualElement name="Tooltip" class="tooltip-box" style="display: none; position: absolute;">
            <ui:Label name="TooltipTitle" text="Nazwa Budynku" class="tooltip-header" />
            <ui:Label name="TooltipBody" text="Opis..." class="tooltip-text" />
            <ui:Label name="TooltipCost" text="Koszt: 100 G" class="tooltip-cost" />
        </ui:VisualElement>
        <ui:VisualElement name="TutorialPopup" class="tutorial-popup" style="top: 295px; right: 636px; left: 494px; bottom: auto; position: absolute; align-items: center; justify-content: flex-start; align-self: auto; align-content: auto; overflow: visible;">
            <ui:Button name="Btn_CloseTutorial" text="X" class="tutorial-close-btn" />
            <ui:Label text="Żeby budynek generował surowce lub żeby wieże strzelały potrzebują pracowników.&#10;&#10;Kliknij na budynek aby otworzyć menu.&#10;&#10;Twoi pracownicy pracują tylko podczas zmian." class="tutorial-text" />
        </ui:VisualElement>


        <!-- TOOLTIP ZASOBÓW (Prognoza) -->
    <ui:VisualElement name="ResourceTooltip" class="resource-tooltip" style="display: none;">
        <ui:Label name="ResTool_Name" text="DREWNO" style="color: #FFD700; -unity-font-style: bold; margin-bottom: 5px; border-bottom-width: 1px; border-bottom-color: #555;" />
        
        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
            <ui:Label text="Przychód:" style="color: #CCC; font-size: 11px;" />
            <ui:Label name="ResTool_Gain" text="+50.0" style="color: #44FF44; font-size: 11px;" />
        </ui:VisualElement>

        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
            <ui:Label text="Wydatki:" style="color: #CCC; font-size: 11px;" />
            <ui:Label name="ResTool_Loss" text="-10.0" style="color: #FF4444; font-size: 11px;" />
        </ui:VisualElement>
        
        <ui:VisualElement style="height: 1px; background-color: #555; margin-top: 3px; margin-bottom: 3px;" />

        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
            <ui:Label text="BILANS:" style="color: white; -unity-font-style: bold;" />
            <ui:Label name="ResTool_Net" text="+40.0" style="color: #44FF44; -unity-font-style: bold;" />
        </ui:VisualElement>
    </ui:VisualElement>

    </ui:VisualElement>
    <ui:VisualElement name="HealthBarLayer" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%; top: 3px; left: 3px;" />
</ui:UXML>
