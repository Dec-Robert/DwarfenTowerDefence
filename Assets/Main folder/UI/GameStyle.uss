/* --- G£ÓWNY KONTENER --- */
.root-container {
    flex-grow: 1;
    justify-content: space-between;
    padding: 10px;
    width: 100%;
    height: 100%;
}

/* --- PASEK GÓRNY (Surowce) --- */
.top-bar {
    flex-direction: row;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 10px;
    padding: 8px;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    /* NOWOŒÆ: Pozwala elementom spaœæ ni¿ej na ma³ym ekranie */
    flex-wrap: wrap; 
}

/* Pojedynczy zasób (Ikona + Tekst) */
.resource-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: auto;
    min-width: 90px;      /* Zwiêkszone z 80px */
    height: 40px;         /* Zwiêkszone z 32px (+25%) */
    flex-shrink: 0;
    background-color: rgba(10, 25, 45, 0.85);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding-left: 10px;   /* Wiêkszy padding */
    padding-right: 10px;
    margin-left: 5px;
    margin-right: 5px;
    margin-bottom: 2px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
}

.resource-icon {
    width: 24px;          /* Zwiêkszone z 20px */
    height: 24px;         /* Zwiêkszone z 20px */
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    margin-right: 8px;    /* Wiêkszy odstêp od tekstu */
    border-radius: 4px;
}

.resource-text {
    font-size: 18px;      /* Zwiêkszone z 15px */
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* Specjalny kolor dla czasu */
.time-text {
    font-size: 20px;
    color: #44FF44;
    /* Marginesy s¹ teraz obs³ugiwane w UXML, ale to zostaje jako fallback */
    margin-left: 20px;
    margin-right: 20px;
}

/* --- PASEK DOLNY (Kontrolki) --- */
.bottom-container {
    flex-direction: row;
    align-items: flex-end;
    /* Usuwamy justify-content space-between, bo UXML u¿ywa flex-grow */
}

/* Panel Czasu */
.time-controls-panel {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    padding: 5px;
}

.time-btn {
    width: 40px;
    height: 40px;
    margin: 2px;
    background-color: #555;
    border-radius: 5px;
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 0;
}

.time-btn:hover { background-color: #777; }
.time-btn:active { background-color: #333; }

/* --- PRZYCISK OTWIERANIA BUDOWANIA --- */
/* (Usun¹³em stary .build-menu-btn jeœli nie u¿ywasz, zostawiam main-build-btn) */

/* G£ÓWNY PRZYCISK BUDOWANIA */
.main-build-btn {
    width: 80px;
    height: 80px;
    background-color: #2E7D32;
    border-radius: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    margin: 5px; /* Mniejszy margines ¿eby nie marnowaæ miejsca */
    border-width: 2px;
    border-color: #4CAF50;
}
.main-build-btn:hover { background-color: #4CAF50; scale: 1.05; }
.main-build-btn:active { background-color: #1B5E20; scale: 0.95; }

/* --- PANEL KATEGORII --- */
.category-panel {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 10px;
    padding: 5px;
    margin-bottom: 5px;
    height: 60px;
    align-items: center;
}

.category-btn {
    width: 60px;
    height: 50px;
    margin: 0 5px;
    background-color: #444;
    color: white;
    font-size: 10px;
    border-radius: 5px;
    -unity-text-align: middle-center;
    white-space: normal; /* ¯eby d³ugie nazwy siê zawija³y */
}
.category-btn:hover { background-color: #666; border-color: yellow; border-width: 1px; }
.category-btn-active { background-color: #FFD700; color: black; }

/* --- PANEL LISTY BUDYNKÓW --- */
.buildings-list-panel {
    height: 100px;
    background-color: rgba(20, 20, 20, 0.95);
    border-radius: 12px;
    border-width: 2px;
    border-color: #444;
    padding: 10px;
    
    /* KLUCZOWA ZMIANA: Usuwamy sztywne width */
    /* width: 640px;  <-- USUNIÊTE */
    
    /* Opcjonalnie: ograniczamy max szerokoœæ na ultra-szerokich ekranach, ¿eby nie krêciæ g³ow¹ */
    max-width: 1600px; 
    
    justify-content: center;
}

.buildings-scroll-view {
    height: 100%;
    width: 100%;
}

.generated-build-btn {
    width: 80px;
    height: 80px;
    margin: 5px;
    background-color: #333;
    border-radius: 8px;
    border-width: 2px;
    border-color: #555;
    justify-content: flex-end;
    overflow: hidden;
    flex-shrink: 0; /* Wa¿ne: przyciski nie mog¹ siê œciskaæ */
}

.generated-build-btn:hover {
    border-color: #FFD700;
    scale: 1.05;
}

/* --- SCROLLBARY --- */
#unity-vertical-scroller { display: none; width: 0; }

#unity-horizontal-scroller {
    height: 6px;
    margin-top: 4px;
}

#unity-horizontal-scroller #unity-dragger {
    background-color: #555;
    border-radius: 3px;
    height: 6px;
}

.buildings-container {
    flex-direction: row;
    align-items: center;
}

/* --- TOOLTIPY I MENU --- */

.tooltip-box {
    background-color: rgba(0, 0, 0, 0.9);
    border-width: 1px;
    border-color: #666;
    border-radius: 6px;
    padding: 10px;
    width: 250px;
}

.tooltip-header {
    color: #FFD700;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: #444;
}

.tooltip-text {
    color: #DDD;
    font-size: 12px;
    white-space: normal;
    margin-bottom: 5px;
}

.tooltip-cost {
    color: #FFAAAA;
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 5px;
    border-top-width: 1px;
    border-top-color: #444;
    padding-top: 2px;
}

/* MENU EKSPANSJI */
.expansion-panel {
    /* Pozycjonowanie jest teraz w UXML (absolute center), tu tylko wygl¹d */
    width: 300px;
    background-color: rgba(10, 10, 20, 0.95);
    border-color: #446688;
    border-width: 2px;
    border-radius: 8px;
    padding: 15px;
    align-items: stretch;
}

.expansion-header {
    color: #88CCFF;
    font-size: 18px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: #446688;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.expansion-text {
    color: #DDD;
    font-size: 13px;
    white-space: normal;
    margin-bottom: 5px;
}

.expansion-btn-buy {
    background-color: #2E7D32;
    color: white;
    border-radius: 4px;
    flex-grow: 1;
    margin-right: 5px;
    height: 35px;
}
.expansion-btn-buy:hover { background-color: #4CAF50; }
.expansion-btn-buy:disabled { background-color: #555; color: #888; }

.expansion-btn-close {
    background-color: #C62828;
    color: white;
    border-radius: 4px;
    flex-grow: 1;
    margin-left: 5px;
    height: 35px;
}
.expansion-btn-close:hover { background-color: #E53935; }

/* BEACON BAR */
.beacon-bar-bg {
    flex-direction: row;
    background-color: rgba(10, 20, 35, 0.9);
    padding: 4px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0.5);
    align-items: center;
}

.beacon-segment {
    width: 18px;
    height: 10px;
    margin: 1px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.1);
}

/* TUTORIAL POPUP */
.tutorial-popup {
    /* Pozycjonowanie przeniesione do UXML */
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 1px;
    border-color: #FFD700;
    border-radius: 8px;
    padding: 15px;
    padding-top: 20px;
}

.tutorial-text {
    color: #EEE;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.tutorial-close-btn {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    background-color: #C62828;
    color: white;
    font-size: 10px;
    border-radius: 10px;
    border-width: 0;
}
.tutorial-close-btn:hover { background-color: #FF5555; }

/* RESOURCE TOOLTIP */
.resource-tooltip {
    position: absolute;
    background-color: rgba(20, 25, 30, 0.98);
    border-radius: 5px;
    border-width: 1px;
    border-color: #666;
    padding: 10px;
    width: 160px;
}

/* Ikony - jeœli u¿ywasz */
.icon-gold { background-image: url('project://database/Assets/Main folder/Icons/Resources/Gold.tif'); }
.icon-wood { background-image: url('project://database/Assets/Main folder/Icons/Resources/Wood.tif'); }
.icon-stone { background-image: url('project://database/Assets/Main folder/Icons/Resources/Stone.tif'); }
.icon-iron { background-image: url('project://database/Assets/Main folder/Icons/Resources/Iron.tif'); }
.icon-coal { background-image: url('project://database/Assets/Main folder/Icons/Resources/Coal.tif'); }
.icon-food { background-image: url('project://database/Assets/Main folder/Icons/Resources/Food.tif'); }