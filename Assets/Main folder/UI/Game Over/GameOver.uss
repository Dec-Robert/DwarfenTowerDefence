.game-over-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(40, 0, 0, 0.9); /* Krwista czerñ */
    align-items: center;
    justify-content: center;
}

.game-over-panel {
    width: 500px;
    background-color: rgb(20, 20, 20);
    border-width: 2px;
    border-color: #880000;
    border-radius: 10px;
    padding: 30px;
    align-items: center;
}

.game-over-title {
    font-size: 40px;
    color: #FF0000;
    -unity-font-style: bold;
    margin-bottom: 10px;
    text-shadow: 2px 2px 0px rgba(0,0,0,0.8);
}

.game-over-stats {
    font-size: 20px;
    color: #DDD;
    margin-bottom: 30px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.game-over-btn {
    width: 80%;
    height: 50px;
    font-size: 18px;
    margin-bottom: 10px;
    border-radius: 5px;
    border-width: 0;
    color: white;
    -unity-font-style: bold;
}

.btn-restart { background-color: #2E7D32; }
.btn-restart:hover { background-color: #4CAF50; }

.btn-menu { background-color: #444; }
.btn-menu:hover { background-color: #666; }