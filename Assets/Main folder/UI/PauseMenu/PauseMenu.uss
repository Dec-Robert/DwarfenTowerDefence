/* T£O BLOKUJ¥CE (Overlay) */
.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7); /* Ciemne przyciemnienie */
    align-items: center;
    justify-content: center;
}

/* G£ÓWNE OKNO */
.pause-window {
    width: 400px;
    background-color: rgb(35, 35, 40);
    border-color: #FFD700;
    border-width: 2px;
    border-radius: 10px;
    padding: 20px;
    align-items: stretch;
}

/* NAG£ÓWEK */
.pause-header {
    font-size: 32px;
    -unity-font-style: bold;
    color: #FFD700;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: #555;
    padding-bottom: 10px;
}

/* PRZYCISKI */
.menu-btn {
    height: 50px;
    font-size: 18px;
    margin-bottom: 10px;
    background-color: #555;
    color: white;
    border-radius: 5px;
    border-width: 0;
    transition: 0.1s;
}

.menu-btn:hover {
    background-color: #777;
    scale: 1.05;
}

.menu-btn:active {
    background-color: #333;
}

.quit-btn {
    background-color: #8B0000;
}
.quit-btn:hover { background-color: #A00000; }

/* POPUP POTWIERDZENIA */
.confirm-popup {
    position: absolute;
    width: 350px;
    background-color: rgb(20, 20, 20);
    border-color: #FF4444;
    border-width: 2px;
    border-radius: 10px;
    padding: 20px;
    align-items: center;
    justify-content: center;
}

.confirm-text {
    font-size: 16px;
    color: white;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.confirm-btn-container {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.btn-yes { background-color: #2E7D32; flex-grow: 1; margin-right: 5px; }
.btn-no { background-color: #C62828; flex-grow: 1; margin-left: 5px; }