.bar-container {
    position: absolute; /* WA¯NE: Pozwala przesuwaæ pasek skryptem */
    flex-direction: row;
    width: 60px;  /* Mniejszy rozmiar na ekranie */
    height: 8px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 2px;
    /* Domyœlnie ukryty, skrypt go poka¿e */
    visibility: hidden; 
}

/* ... Reszta styli (.segment, .segment-fill, kolory) bez zmian ... */
.segment {
    flex-grow: 1;
    background-color: #333;
    margin-right: 1px;
    margin-left: 1px;
    overflow: hidden;
}

.segment-fill { height: 100%; width: 100%; }
.color-red { background-color: #FF4444; }
.color-blue { background-color: #4488FF; }
.color-green { background-color: #44FF44; }
.color-yellow { background-color: #FFFF44; }
.color-purple { background-color: #AA44FF; }