/* ==================== GŁÓWNE OKNO GRY - MAIN HUB ==================== */
/* Kontener górny*/
.top-bar{
    background-color: #ffffff;
}

.mid-bar{
    background-color: blue;
}
.bottom-bar{
    background-color: green;
}


/* ==================== KLOCEK: ZASÓB (RESOURCE CHIP) ==================== */

/* Główny kontener zasobu (szare tło, zaokrąglone rogi, układ poziomy) */
.resource-chip {
    flex-direction: row;        /* Układa ikonę i tekst obok siebie (poziomo) */
    align-items: center;        /* Centruje elementy w pionie */
    background-color: rgb(50, 50, 50); /* Ciemnoszare tło */
    border-width: 2px;
    border-color: rgb(20, 20, 20);
    border-radius: 6px;         /* Lekko zaokrąglone rogi */
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 10px;         /* Odstęp od kolejnego zasobu */
}

/* Szary kwadracik imitujący ikonę (np. drewna, kamienia) */
.resource-icon {
    width: 24px;
    height: 24px;
    background-color: rgb(150, 150, 150); /* Jasnoszary placeholder na grafikę */
    border-radius: 4px;
    margin-right: 8px;          /* Odstęp między ikoną a tekstem */
}

/* Tekst wyświetlający liczbę (np. "150") */
.resource-value {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    margin: 0;                  /* Resetuje domyślne marginesy tekstu w Unity */
    padding: 0;
}